<Project>
  <!-- Where Valheim is installed. Override with: dotnet build -p:ValheimDir="C:\path\to\Valheim" -->
  <PropertyGroup>
    <ValheimDir Condition="'$(ValheimDir)' == ''">D:\SteamLibrary\steamapps\common\Valheim</ValheimDir>
  </PropertyGroup>
  <!-- Keep local paths (like your Windows user folder) out of the built DLL. -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <!-- Harmless: the game's DLLs reference slightly different .NET versions than netstandard2.1. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
    <PathMap>$(MSBuildThisFileDirectory)=./</PathMap>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
</Project>
